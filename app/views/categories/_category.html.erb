<div class="category-container">
<%= link_to category do %>
  <div class="icon-name">
    <img src="<%= category.icon %>" alt="Category Icon" class="category-icon" />
    <div class="category-details">
      <p class="category-name">
        <%= category.name %>
      </p>
      <p class="category-total">
        <%= number_to_currency(category.amount_spent) %>
        <% if category.budget_limit.present? %>
          / <%= number_to_currency(category.budget_limit) %>
        <% end %>
      </p>
      <% if category.budget_limit.present? %>
        <div class="mini-progress">
          <div class="mini-progress-fill" style="width: <%= [category.budget_percentage, 100].min %>%"></div>
        </div>
      <% end %>
    </div>
  </div>
<% end %> 
<div class="category-actions">
  <%= link_to "Edit", edit_category_path(category), class: "btn-edit", title: "Edit category" %>
  <%= button_to "Delete", category, method: :delete, data: { confirm: "Delete this category and all payments?" }, class: "btn-delete" %>
</div>
</div>
