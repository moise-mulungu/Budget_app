<header class="header">
<div class="navbar">
<%= link_to image_tag("back1.png", :class => "nav-back-button" ), categories_path %>
  <h2 class="nav-title"><%= category.new_record? ? "New Category" : "Edit Category" %></h2>

  <%= link_to "Log out", destroy_user_session_path, :class => "nav-logout" %>
  </div>
</header> 

<%= form_with(model: category, :class => "category-form") do |form| %>
  <% if category.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(category.errors.count, "error") %> prohibited this category from being saved:</h2>
      <ul>
        <% category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, "Category Name" %>
    <%= form.text_field :name, placeholder: "e.g., Groceries, Utilities", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :icon, "Icon URL" %>
    <%= form.text_field :icon, placeholder: "Enter image URL" %>
  </div>

  <div class="form-group">
    <%= form.label :budget_limit, "Monthly Budget Limit (Optional)" %>
    <%= form.number_field :budget_limit, placeholder: "e.g., 500", step: 0.01, min: 0 %>
  </div>

  <div class="form-group">
    <%= form.label :description, "Description (Optional)" %>
    <%= form.text_area :description, placeholder: "Add notes about this category", rows: 3 %>
  </div>

  <div class="button-form">
    <%= form.submit category.new_record? ? "Create Category" : "Update Category" %>
  </div>
<% end %>